# ==============================================================================
# BIS Compass | Environment Configuration File
# ==============================================================================

# Application Environment & Server Settings
APP_NAME="BIS Compass"
APP_VERSION="2.0.0"
APP_ENV="development"
PORT=8080
HOST="localhost"

# Public Application Base URL
PUBLIC_URL="http://localhost:8080"

# Official Bureau of Indian Standards (BIS) Portal Endpoints
BIS_OFFICIAL_PORTAL="https://www.bis.gov.in"
BIS_MANAKONLINE_PORTAL="https://www.manakonline.in"
BIS_CARE_APP_PORTAL="https://www.bis.gov.in/bis-care/"
NATIONAL_CONSUMER_HELPLINE="1915"

# Scanner Engine & Audio Configuration
ENABLE_CAMERA_SCANNER=true
ENABLE_JSQR_DECODER=true
ENABLE_SPEECH_SYNTHESIS=true
ENABLE_MULTILINGUAL=true
DEFAULT_LANGUAGE="en" # Options: en, hi, te
